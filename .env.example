# =============================================================
# Variables de entorno para despliegue con Docker Compose
# Copie este archivo como ".env" y complete los valores reales.
# El archivo ".env" esta excluido del control de versiones.
# =============================================================

# --- Base de datos PostgreSQL (obligatorio) ---
POSTGRES_DB=infra_copilot
POSTGRES_USER=infra_admin
# Contrasena de la base de datos. Use un valor aleatorio y robusto.
POSTGRES_PASSWORD=cambie-esta-contrasena-por-una-aleatoria

# --- Aplicacion web ---
# Puerto local donde se expone la consola.
APP_PORT=8501

# --- Motor de IA (opcional) ---
# Clave de Google Gemini. Si se deja vacia, la consola opera en modo local autonomo.
GEMINI_API_KEY=

# --- Boveda de seguridad (opcional pero recomendado) ---
# Clave maestra Fernet (32 bytes base64). Si se deja vacia, se genera
# una clave en data/.vault.key y debe persistirse mediante el volumen ./data.
VAULT_MASTER_KEY=

# --- Contrasenas maestras RBAC (opcional, sobrescriben las de fabrica) ---
# Si se definen, prevalecen sobre las cuentas iniciales del seed.
ADMIN_PASSWORD=
OPERADOR_PASSWORD=
AUDITOR_PASSWORD=
